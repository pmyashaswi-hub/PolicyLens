# PolicyLens Environment Variables
# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (default is gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Retrieval tunables
# DENSE_TOP_K=20
# BM25_TOP_K=20
# DEFAULT_TOP_K=5
# RETRIEVAL_GATE_THRESHOLD=0.015
